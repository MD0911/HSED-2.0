<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HSED_2_0.Terminal"
        Width="800" Height="480"
        SystemDecorations="None"
        Background="Transparent"
        WindowStartupLocation="Manual"
        Title="HSED_2_0"
        CanResize="False">

	<!-- Globale Button-Styles -->
	<Window.Styles>
		<Style Selector="Button">
			<Setter Property="CornerRadius" Value="5"/>
			<Setter Property="Background" Value="#444444"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontFamily" Value="Segoe UI"/>
		</Style>
	</Window.Styles>

	<!-- Wrapper für die Rotation und Skalierung -->
	<LayoutTransformControl x:Name="RootLayoutTransform">
		<LayoutTransformControl.LayoutTransform>
			<TransformGroup>
				<RotateTransform Angle="90"/>
				<ScaleTransform ScaleX="1" ScaleY="1"/>
			</TransformGroup>
		</LayoutTransformControl.LayoutTransform>

		<!-- Dein Canvas -->
		<Canvas x:Name="MainCanvas" Margin="-390,-280,0,0">

			<!-- Äußerer Rahmen -->
			<Border BorderThickness="3"
                    BorderBrush="#22c55e"
                    Background="#111827"
                    Width="220"
                    Height="400"
                    Canvas.Top="10"
                    Canvas.Left="280"
                    CornerRadius="10">
				<Border.Effect>
					<DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.5"/>
				</Border.Effect>
			</Border>

			<!-- LCD Display -->
			<Border BorderThickness="2"
                    BorderBrush="Black"
                    Background="Black"
                    Width="200"
                    Height="100"
                    Canvas.Top="20"
                    Canvas.Left="290"
                    CornerRadius="5"
                    Padding="5">
				<Grid x:Name="DisplayGrid">
					<!-- Unteres Grid -->
					<UniformGrid x:Name="ImageGrid" Columns="28" Rows="4">
						<!-- Row 1 -->
						<Image x:Name="Cell_1_1" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_2" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_3" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_4" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_5" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_6" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_7" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_8" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_9" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_10" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_11" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_12" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_13" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_14" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_15" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_16" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_17" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_18" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_19" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_20" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_21" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_22" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_23" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_24" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_25" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_26" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_27" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_1_28" Margin="0" Stretch="Uniform"/>

						<!-- Row 2 -->
						<Image x:Name="Cell_2_1" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_2" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_3" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_4" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_5" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_6" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_7" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_8" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_9" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_10" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_11" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_12" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_13" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_14" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_15" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_16" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_17" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_18" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_19" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_20" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_21" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_22" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_23" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_24" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_25" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_26" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_27" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_2_28" Margin="0" Stretch="Uniform"/>

						<!-- Row 3 -->
						<Image x:Name="Cell_3_1" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_2" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_3" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_4" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_5" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_6" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_7" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_8" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_9" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_10" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_11" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_12" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_13" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_14" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_15" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_16" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_17" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_18" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_19" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_20" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_21" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_22" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_23" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_24" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_25" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_26" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_27" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_3_28" Margin="0" Stretch="Uniform"/>

						<!-- Row 4 -->
						<Image x:Name="Cell_4_1" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_2" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_3" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_4" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_5" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_6" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_7" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_8" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_9" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_10" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_11" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_12" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_13" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_14" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_15" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_16" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_17" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_18" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_19" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_20" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_21" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_22" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_23" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_24" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_25" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_26" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_27" Margin="0" Stretch="Uniform"/>
						<Image x:Name="Cell_4_28" Margin="0" Stretch="Uniform"/>
					</UniformGrid>
					<Border x:Name="ColumnSeparatorOverlay"
                            Width="1"
                            Background="#FFD60A"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            UseLayoutRounding="True"
                            IsVisible="False"
                            IsHitTestVisible="False"/>
				</Grid>
			</Border>

			<!-- Tastatur -->
			<Border Background="#111827"
                    Width="200"
                    Height="240"
                    Canvas.Top="120"
                    Canvas.Left="290"
                    CornerRadius="8"
                    Padding="5">
				<UniformGrid x:Name="KeyboardGrid" Rows="5" Columns="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
					<Button Tag="1" Width="50" Height="40" Background="#2250C7" Content="1" FontSize="20" FontWeight="Bold" Margin="8,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnKeyButtonClick"/>
					<Button Tag="2" Width="50" Height="40" Background="#2250C7" Content="2" FontSize="20" FontWeight="Bold" Margin="8,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnKeyButtonClick"/>
					<Button Tag="3" Width="50" Height="40" Background="#2250C7" Content="3" FontSize="20" FontWeight="Bold" Margin="8,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnKeyButtonClick"/>
					<Button Tag="4" Width="50" Height="40" Background="#2250C7" Content="4" FontSize="20" FontWeight="Bold" Margin="8,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnKeyButtonClick"/>
					<Button Tag="5" Width="50" Height="40" Background="#2250C7" Content="5" FontSize="20" FontWeight="Bold" Margin="8,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnKeyButtonClick"/>
					<Button Tag="6" Width="50" Height="40" Background="#2250C7" Content="6" FontSize="20" FontWeight="Bold" Margin="8,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnKeyButtonClick"/>
					<Button Tag="7" Width="50" Height="40" Background="#2250C7" Content="7" FontSize="20" FontWeight="Bold" Margin="8,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnKeyButtonClick"/>
					<Button Tag="8" Width="50" Height="40" Background="#2250C7" Content="8" FontSize="20" FontWeight="Bold" Margin="8,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnKeyButtonClick"/>
					<Button Tag="9" Width="50" Height="40" Background="#2250C7" Content="9" FontSize="20" FontWeight="Bold" Margin="8,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnKeyButtonClick"/>
					<Button Tag="F1" Width="50" Height="40" Background="#2250C7" Content="F1" FontSize="20" FontWeight="Bold" Margin="8,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnKeyButtonClick"/>
					<Button Tag="0" Width="50" Height="40" Background="#2250C7" Content="0" FontSize="20" FontWeight="Bold" Margin="8,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnKeyButtonClick"/>
					<Button Tag="F2" Width="50" Height="40" Background="#2250C7" Content="F2" FontSize="20" FontWeight="Bold" Margin="8,0"
							HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnKeyButtonClick"/>
					<Button Width="50" Height="40" Background="#facc15" Content="←" FontSize="20" FontWeight="Bold" Margin="8,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnKeyButtonClick"/>
					<Button Width="50" Height="40" Background="#facc15" Content="↑" FontSize="20" FontWeight="Bold" Margin="10,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnKeyButtonClick"/>
					<Button Width="50" Height="40" Background="#facc15" Content="→" FontSize="20" FontWeight="Bold" Margin="10,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnKeyButtonClick"/>
					<Button Tag="ESC" Width="50" Height="40" Background="#ef4444" Content="ESC" FontSize="17" FontWeight="Bold" Margin="10,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnKeyButtonClick"/>
					<Button Width="50" Height="40" Background="#facc15" Content="↓" FontSize="20" FontWeight="Bold" Margin="10,0"
							HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnKeyButtonClick"/>
					<Button Tag="ENT" Width="50" Height="40" Background="#22c55e" Content="ENT" FontSize="17" FontWeight="Bold" Margin="10,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnKeyButtonClick"/>

					<ContentControl />
				</UniformGrid>
			</Border>

			<!-- Close Button -->
			<Canvas>
				<Button Canvas.Left="470" Canvas.Top="-25" CornerRadius="90" Width="30" Height="30" Background="Red" Click="Button_Click">
					<TextBlock Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">X</TextBlock>
				</Button>
				<Button Canvas.Left="435" Canvas.Top="-25" CornerRadius="90" Width="30" Height="30" Background="#facc15" Click="Button_Click_1">
					<Image Name="FensterSizeButton" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0" Width="14" Height="14" Source=""></Image>
				</Button>
			</Canvas>

		</Canvas>
	</LayoutTransformControl>
</Window>
