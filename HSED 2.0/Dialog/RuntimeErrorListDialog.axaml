<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HSED_2._0.RuntimeErrorListDialog"
        Width="260"
        Height="520"
        Background="Transparent"
        CanResize="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="Border.dialogCard">
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Background" Value="#1f2937"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#2b3546"/>
      <Setter Property="BoxShadow" Value="0 14 40 #00000066"/>
      <Setter Property="Padding" Value="18"/>
    </Style>

    <Style Selector="TextBlock.dTitle">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style Selector="TextBlock.dSub">
      <Setter Property="Foreground" Value="#9ca3af"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style Selector="Button.errorItem">
      <Setter Property="Width" Value="300"/>
      <Setter Property="Height" Value="52"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="#0f172a"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#2b3546"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="8,0"/>
    </Style>

    <Style Selector="Button.errorItem:pointerover">
      <Setter Property="Background" Value="#243246"/>
    </Style>

    <Style Selector="Button.close">
      <Setter Property="Width" Value="120"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="#111827"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#374151"/>
      <Setter Property="Foreground" Value="#d1d5db"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
    <Border Classes="dialogCard" Width="400" Height="220">
      <Border.RenderTransform>
        <RotateTransform Angle="90"/>
      </Border.RenderTransform>

      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="4" HorizontalAlignment="Center">
          <TextBlock Text="Fehlerspeicher" Classes="dTitle" TextAlignment="Center"/>
          <TextBlock x:Name="ErrorCountText" Text="" Classes="dSub" TextAlignment="Center"/>
        </StackPanel>

        <StackPanel x:Name="ErrorListPanel"
                    Grid.Row="1"
                    Spacing="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,14"/>

        <Button Grid.Row="2"
                Classes="close"
                HorizontalAlignment="Center"
                Click="Close_Click">Schließen</Button>
      </Grid>
    </Border>
  </Grid>
</Window>
