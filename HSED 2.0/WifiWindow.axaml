<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:HSED_2._0.Models"
        xmlns:vm="clr-namespace:HSED_2._0.ViewModels"
        x:Class="HSED_2._0.WifiWindow"
        x:DataType="vm:WifiViewModel"
        Width="800"
        Height="480"
        Background="#111827"
        FontFamily="DejaVu Sans"
        Title="HSED_2._0"
        CanResize="False"
        SystemDecorations="None"
        WindowStartupLocation="Manual">

  <Window.Styles>

    <Style Selector="TextBlock.h1">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#9ca3af"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style Selector="TextBlock.ssidWhite">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style Selector="TextBlock.sub">
      <Setter Property="Foreground" Value="#9ca3af"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="Border.panel">
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Background" Value="#0f172a"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#1f2a3b"/>
    </Style>

    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- WICHTIG: ContentTemplate weiterreichen, sonst DataTemplate wird NICHT benutzt -->
    <Style Selector="ListBox#WifiList ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="MinHeight" Value="84"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="Bd"
                  CornerRadius="12"
                  Background="#111827"
                  BorderThickness="1"
                  BorderBrush="#1f2a3b"
                  Padding="14">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="ListBox#WifiList ListBoxItem:pointerover /template/ Border#Bd">
      <Setter Property="Background" Value="#0b1220"/>
      <Setter Property="BorderBrush" Value="#2a3a55"/>
    </Style>

    <Style Selector="ListBox#WifiList ListBoxItem:selected /template/ Border#Bd">
      <Setter Property="Background" Value="#0b1220"/>
      <Setter Property="BorderBrush" Value="#334155"/>
    </Style>

    <Style Selector="Border.statusBox">
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="#111827"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#1f2a3b"/>
      <Setter Property="Padding" Value="12"/>
    </Style>

    <Style Selector="Button.action">
      <Setter Property="Height" Value="52"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#1d4ed8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border CornerRadius="14" Background="{TemplateBinding Background}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.action:pointerover">
      <Setter Property="Background" Value="#1e40af"/>
    </Style>

    <Style Selector="Button.action:pressed">
      <Setter Property="Background" Value="#1e3a8a"/>
    </Style>

  </Window.Styles>

  <Canvas>

    <Border Canvas.Left="60" Width="740" Height="480" Background="#111827"/>

    <Border Canvas.Left="665" Canvas.Top="125" Width="740" Height="480" Background="#111827">
      <Border Width="480" Height="740" ClipToBounds="False" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
          <RotateTransform Angle="90"/>
        </Border.RenderTransform>

        <Border Classes="panel" Margin="14" Padding="16">
          <Grid RowDefinitions="Auto,*,Auto">

            <Grid Grid.Row="0" ColumnDefinitions="*,160">
              <StackPanel>
                <TextBlock Text="WLAN" Classes="h1"/>
                <TextBlock Text="Tippe ein Netzwerk an" Classes="muted" Margin="0,4,0,0"/>
              </StackPanel>

              <Button Grid.Column="1"
                      Width="70"
                      Height="30"
                      Margin="100,0,0,0"
                      Classes="action"
                      Content="Refresh"
                      Command="{Binding ScanCommand}"/>
            </Grid>

            <ListBox x:Name="WifiList"
                     Grid.Row="1"
                     Margin="0,14,0,0"
                     ItemsSource="{Binding Networks}"
                     SelectedItem="{Binding SelectedNetwork}"
                     SelectionMode="Single"
                     SelectionChanged="WifiList_SelectionChanged"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">

              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:WifiNetworkItem">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">

                    <TextBlock Text="{Binding Ssid}" Classes="ssidWhite"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding SignalText}"
                               Classes="muted"
                               HorizontalAlignment="Right"/>

                    <TextBlock Grid.Row="1"
                               Text="{Binding Security}"
                               Classes="sub"
                               Margin="0,6,0,0"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding Details}"
                               Classes="sub"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Right"/>

                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>

            </ListBox>

            <Border Grid.Row="2" Classes="statusBox" Margin="0,-6,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Canvas Width="18" Height="18" IsVisible="{Binding IsScanning}">
                  <Ellipse x:Name="ScanSpinner"
                           Width="18"
                           Height="18"
                           Stroke="#9ca3af"
                           StrokeThickness="2"
                           StrokeDashArray="2,6"
                           RenderTransformOrigin="0.5,0.5"
                           IsVisible="{Binding IsScanning}">
                    <Ellipse.RenderTransform>
                      <RotateTransform Angle="0"/>
                    </Ellipse.RenderTransform>
                  </Ellipse>
                </Canvas>
                <TextBlock Text="{Binding StatusText}" Classes="muted" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>

          </Grid>
        </Border>
      </Border>
    </Border>

    <Border Background="#1f2937" Width="60" Height="480"/>

    <!-- Overlay -->
    <Border x:Name="Overlap"
            Background="#1f2937"
            Width="800"
            Height="480"
            Opacity="1"
            IsVisible="False"/>

    <!-- NavBar unchanged -->
    <Border x:Name="NavBar" Background="#1f2937" Width="60" Height="480">
      <StackPanel x:Name="StackPanelNavBar" HorizontalAlignment="Center" Margin="0,25,0,0">

        <Button Background="#1f2937" Tag="Menu" x:Name="ButtonSettings" Width="50" Height="40" Click="Button_Click_Settings">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Image Source="Images\Icons\menu-offnen.png" RenderOptions.BitmapInterpolationMode="LowQuality">
              <Image.RenderTransform>
                <RotateTransform Angle="90"/>
              </Image.RenderTransform>
            </Image>
            <TextBlock Margin="10,5,0,0" x:Name="SettingsText" IsVisible="False" Foreground="White">Menue</TextBlock>
          </StackPanel>
        </Button>

        <Button Background="#1f2937" Tag="Home" x:Name="ButtonSettings7" Width="50" Height="40" Margin="0,5,0,0" Click="Button_Click_Settings">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Image Source="Images\Icons\zuhause.png" RenderOptions.BitmapInterpolationMode="LowQuality">
              <Image.RenderTransform>
                <RotateTransform Angle="90"/>
              </Image.RenderTransform>
            </Image>
            <TextBlock Margin="10,5,0,0" x:Name="SettingsText7" IsVisible="False" Foreground="White">Home</TextBlock>
          </StackPanel>
        </Button>

        <Button Background="#1f2937" Tag="Testrufe" x:Name="ButtonSettings3" Width="50" Height="40" Margin="0,5,0,0" Click="Button_Click_Settings">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Image Source="Images\Icons\aufzug.png" RenderOptions.BitmapInterpolationMode="LowQuality">
              <Image.RenderTransform>
                <RotateTransform Angle="90"/>
              </Image.RenderTransform>
            </Image>
            <TextBlock Margin="10,5,0,0" x:Name="SettingsText3" IsVisible="False" Foreground="White">Testrufe</TextBlock>
          </StackPanel>
        </Button>

        <Button Background="#1f2937" Tag="Ansicht" x:Name="ButtonSettings4" Width="50" Height="40" Margin="0,5,0,0" Click="Button_Click_Settings">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Image Source="Images\Icons\stift.png" RenderOptions.BitmapInterpolationMode="LowQuality">
              <Image.RenderTransform>
                <RotateTransform Angle="90"/>
              </Image.RenderTransform>
            </Image>
            <TextBlock Margin="10,5,0,0" x:Name="SettingsText4" IsVisible="False" Foreground="White">Terminal</TextBlock>
          </StackPanel>
        </Button>

        <Button Background="#1f2937" Tag="SelfDia" x:Name="ButtonSettings6" Width="50" Height="40" Margin="0,5,0,0" Click="Button_Click_Settings">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Image Source="Images\Icons\analysieren.png" RenderOptions.BitmapInterpolationMode="LowQuality">
              <Image.RenderTransform>
                <RotateTransform Angle="90"/>
              </Image.RenderTransform>
            </Image>
            <TextBlock Margin="10,5,0,0" x:Name="SettingsText6" IsVisible="False" Foreground="White">Self Dia</TextBlock>
          </StackPanel>
        </Button>

        <Button Background="#1f2937" Tag="Settings" x:Name="ButtonSettings2" Width="50" Height="40" Margin="0,180,0,0" Click="Button_Click_Settings">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Image Source="Images/Icons/die-einstellungen.png" RenderOptions.BitmapInterpolationMode="LowQuality">
              <Image.RenderTransform>
                <RotateTransform Angle="90"/>
              </Image.RenderTransform>
            </Image>
            <TextBlock Margin="10,5,0,0" x:Name="SettingsText2" IsVisible="False" Foreground="White">Settings</TextBlock>
          </StackPanel>
        </Button>

      </StackPanel>
    </Border>

  </Canvas>
</Window>
