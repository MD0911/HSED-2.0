<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HSED_2._0.ViewModels"
        xmlns:controls="clr-namespace:HSED_2._0.Controls"
        x:Class="HSED_2._0.WifiPasswordWindow"
        x:DataType="vm:WifiViewModel"
        Width="800"
        Height="480"
        Background="#111827"
        FontFamily="DejaVu Sans"
        Title="Passwort"
        CanResize="False"
        SystemDecorations="None"
        WindowStartupLocation="Manual">

  <Window.Styles>

    <!-- Typography -->
    <Style Selector="TextBlock.h1">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#9ca3af"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="TextBlock.ssidWhite">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Panel -->
    <Style Selector="Border.panel">
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Background" Value="#0f172a"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#1f2a3b"/>
    </Style>

    <!-- Box -->
    <Style Selector="Border.box">
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="#111827"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#1f2a3b"/>
      <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- Buttons -->
    <Style Selector="Button.action">
      <Setter Property="Height" Value="52"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#1d4ed8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border CornerRadius="14"
                  Background="{TemplateBinding Background}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Foreground="{TemplateBinding Foreground}"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.action:pointerover">
      <Setter Property="Background" Value="#1e40af"/>
    </Style>

    <Style Selector="Button.action:pressed">
      <Setter Property="Background" Value="#1e3a8a"/>
    </Style>

    <Style Selector="Button.secondary">
      <Setter Property="Height" Value="40"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#334155"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border CornerRadius="14"
                  Background="{TemplateBinding Background}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Foreground="{TemplateBinding Foreground}"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Password Box -->
    <Style Selector="TextBox.pwd">
      <Setter Property="Height" Value="52"/>
      <Setter Property="Background" Value="#0b1220"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#1f2a3b"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="FontSize" Value="16"/>
    </Style>

  </Window.Styles>

  <Canvas>

    <Border Canvas.Left="60"
            Canvas.Top="0"
            Width="740"
            Height="480"
            Background="#111827"/>

    <Border Canvas.Left="665"
            Canvas.Top="125"
            Width="740"
            Height="480"
            Background="#111827">

      <Border Width="480"
              Height="740"
              RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
          <RotateTransform Angle="90"/>
        </Border.RenderTransform>

        <Border Classes="panel" Margin="14" Padding="16">

          <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,160">
              <StackPanel>
                <TextBlock Text="WLAN Passwort" Classes="h1"/>
                <TextBlock Text="Gib das Passwort ein und verbinde" Classes="muted" Margin="0,4,0,0"/>
              </StackPanel>

            </Grid>

            <!-- SSID -->
            <Border Grid.Row="1" Classes="box" Margin="0,14,0,0">
              <StackPanel Spacing="6">
                <TextBlock Text="Ausgewaehltes Netzwerk" Classes="muted"/>
                <TextBlock Text="{Binding SelectedNetwork.Ssid}" Classes="ssidWhite"/>
              </StackPanel>
            </Border>

            <!-- Password -->
            <Border Grid.Row="2" Classes="box" Margin="0,10,0,0">
              <Grid ColumnDefinitions="*,220">
                <TextBox x:Name="PasswordBox"
                         Classes="pwd"
                         Watermark="Passwort"
                         Text="{Binding WifiPassword}"
                         PasswordChar="*"
                         InputMethod.IsInputMethodEnabled="False"
                         PointerPressed="PasswordBox_PointerPressed"/>

                <Button Grid.Column="1"
                        Width="120"
                        Classes="action"
                        Content="Verbinden"
                        Margin="100,0,0,0"
                        Click="Connect_Click"/>
              </Grid>
            </Border>

            <!-- Status -->
            <Border Grid.Row="3" Classes="box" Margin="0,10,0,0">
              <TextBlock Text="{Binding StatusText}" Classes="muted"/>
            </Border>

            <!-- Keyboard (immer sichtbar) -->
            <Border Grid.Row="4"
                    Margin="0,100,0,0"
                    IsVisible="True">
              <controls:OnScreenKeyboard/>
            </Border>

          </Grid>

        </Border>
      </Border>
    </Border>

    <Border Background="#1f2937" Width="60" Height="480"/>

    <!-- Overlay -->
    <Border x:Name="Overlap"
            Background="#1f2937"
            Width="800"
            Height="480"
            Opacity="1"
            IsVisible="False"/>

    <!-- NavBar unchanged -->
    <Border x:Name="NavBar" Background="#1f2937" Width="60" Height="480">
      <StackPanel x:Name="StackPanelNavBar" HorizontalAlignment="Center" Margin="0,25,0,0">

        <Button Background="#1f2937" Tag="Menu" x:Name="ButtonSettings" Width="50" Height="40" Click="Button_Click_Settings">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Image Source="Images\Icons\menu-offnen.png" RenderOptions.BitmapInterpolationMode="LowQuality">
              <Image.RenderTransform>
                <RotateTransform Angle="90"/>
              </Image.RenderTransform>
            </Image>
            <TextBlock Margin="10,5,0,0" x:Name="SettingsText" IsVisible="False" Foreground="White">Menue</TextBlock>
          </StackPanel>
        </Button>

        <Button Background="#1f2937" Tag="Home" x:Name="ButtonSettings7" Width="50" Height="40" Margin="0,5,0,0" Click="Button_Click_Settings">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Image Source="Images\Icons\zuhause.png" RenderOptions.BitmapInterpolationMode="LowQuality">
              <Image.RenderTransform>
                <RotateTransform Angle="90"/>
              </Image.RenderTransform>
            </Image>
            <TextBlock Margin="10,5,0,0" x:Name="SettingsText7" IsVisible="False" Foreground="White">Home</TextBlock>
          </StackPanel>
        </Button>

        <Button Background="#1f2937" Tag="Testrufe" x:Name="ButtonSettings3" Width="50" Height="40" Margin="0,5,0,0" Click="Button_Click_Settings">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Image Source="Images\Icons\aufzug.png" RenderOptions.BitmapInterpolationMode="LowQuality">
              <Image.RenderTransform>
                <RotateTransform Angle="90"/>
              </Image.RenderTransform>
            </Image>
            <TextBlock Margin="10,5,0,0" x:Name="SettingsText3" IsVisible="False" Foreground="White">Testrufe</TextBlock>
          </StackPanel>
        </Button>

        <Button Background="#1f2937" Tag="Ansicht" x:Name="ButtonSettings4" Width="50" Height="40" Margin="0,5,0,0" Click="Button_Click_Settings">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Image Source="Images\Icons\stift.png" RenderOptions.BitmapInterpolationMode="LowQuality">
              <Image.RenderTransform>
                <RotateTransform Angle="90"/>
              </Image.RenderTransform>
            </Image>
            <TextBlock Margin="10,5,0,0" x:Name="SettingsText4" IsVisible="False" Foreground="White">Terminal</TextBlock>
          </StackPanel>
        </Button>

        <Button Background="#1f2937" Tag="SelfDia" x:Name="ButtonSettings6" Width="50" Height="40" Margin="0,5,0,0" Click="Button_Click_Settings">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Image Source="Images\Icons\refresh.png" RenderOptions.BitmapInterpolationMode="LowQuality">
              <Image.RenderTransform>
                <RotateTransform Angle="90"/>
              </Image.RenderTransform>
            </Image>
            <TextBlock Margin="10,5,0,0" x:Name="SettingsText6" IsVisible="False" Foreground="White">Self Dia</TextBlock>
          </StackPanel>
        </Button>

        <Button Background="#1f2937" Tag="Back" x:Name="ButtonSettings2" Width="50" Height="40" Margin="0,180,0,0" Click="Button_Click_Settings">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Image Source="Images/Icons/enter-taste.png" RenderOptions.BitmapInterpolationMode="LowQuality">
              <Image.RenderTransform>
                <RotateTransform Angle="90"/>
              </Image.RenderTransform>
            </Image>
            <TextBlock Margin="10,5,0,0" x:Name="SettingsText2" IsVisible="False" Foreground="White">ZurÃƒÂ¼ck</TextBlock>
          </StackPanel>
        </Button>

      </StackPanel>
    </Border>

  </Canvas>
</Window>
